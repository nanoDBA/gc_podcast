# Dependencies
node_modules/

# Cache
.cache/

# Build output
dist/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Downloaded/reference files (not part of the project)
*.html
!docs/index.html
!tests/fixtures/*.html
*_files/
*.pdf
*.png
*.jpg
*.jpeg
!docs/channel-art-*.jpg

# Logs
*.log
npm-debug.log*

# AI context (local only), except the shared settings that hold the
# human gate on channel-art selection (CHANNEL_ART.md)
.claude/*
!.claude/settings.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local secrets (public repo: never commit)
.env
.env.*
!.env.example

# Local-only agent instructions (machine paths, cross-project pointers)
CLAUDE.local.md

# Beads runtime files outside .beads/.gitignore (that file is managed by bd init)
.beads.gate.lock
.beads/dolt-server-config.yaml
